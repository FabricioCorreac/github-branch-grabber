{
  "manifest_version": 3,
  "name": "GitHub Branch Grabber",
  "version": "1.0.0",
  "description": "Adds a button to GitHub issues to copy the branch name of the linked pull request.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions":["https://github.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/octicons/*.svg"],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
