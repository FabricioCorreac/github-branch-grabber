{
  "name": "github-branch-grabber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adds a button to GitHub issues to copy the branch name of the linked pull request.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "test": "tsc && node --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm test && npm run build",
    "icons": "node scripts/copy-octicons.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@primer/octicons": "^19.40.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
